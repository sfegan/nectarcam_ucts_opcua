{
  "host": "127.0.0.1",
  "port": 1161,
  "community": "public",
  "description": "UCTS SNMP Device",
  "opcua_path": "Monitoring",
  "poll_interval": 1.0,
  "backoff_interval": 30,
  "default_lifetime": 120.0,
  "oids_per_get": 1,
  "oids": [
    {
      "oid": "AUX-DIAG::wrpcAuxDiagBusyCnt.1",
      "opcua_name": "BusyCount",
      "opcua_type": "Int32",
      "description": "Number of busy triggers rejected during the run"
    },
    {
      "oid": "AUX-DIAG::wrpcAuxDiagEventCnt.1",
      "opcua_name": "EventCount",
      "opcua_type": "Int32",
      "description": "Number of triggers accepted during the run"
    },
    {
      "oid": "AUX-DIAG::wrpcAuxDiagStatus.1",
      "opcua_name": "_RawStatus",
      "opcua_type": "ByteString",
      "description": "(internal) raw uint32 status word as bytes"
    },
    {
      "oid": "WR-WRPC-MIB::wrpcPtpClockOffsetPsHR.0",
      "opcua_name": "PtpClockOffset",
      "opcua_type": "Int32",
      "description": "Current clock offset from master (ps)"
    },
    {
      "oid": "WR-WRPC-MIB::wrpcPtpServoStateN.0",
      "opcua_name": "PtpServoState",
      "opcua_type": "Enum",
      "enum": {
        "0": "uninitialized",
        "1": "syncNsec",
        "2": "syncSec",
        "3": "syncPhase",
        "4": "trackPhase",
        "5": "waitOffsetStable"
      },
      "description": "PTP servo state"
    },
    {
      "oid": "WR-WRPC-MIB::wrpcPortLinkStatus.0",
      "opcua_name": "PortLinkStatus",
      "opcua_type": "Enum",
      "enum": {
        "0": "na",
        "1": "down",
        "2": "up"
      },
      "description": "Port link status",
      "poll_every": 10
    },
    {
      "oid": "WR-WRPC-MIB::wrpcSpllSeqState.0",
      "opcua_name": "SpllSeqState",
      "opcua_type": "Enum",
      "enum": {
        "1": "startExt",
        "2": "waitExt",
        "3": "startHelper",
        "4": "waitHelper",
        "5": "startMain",
        "6": "waitMain",
        "7": "disabled",
        "8": "ready",
        "9": "clearDacs",
        "10": "waitClearDacs"
      },
      "description": "SoftPLL sequence state (should be 'ready')",
      "poll_every": 10
    },
    {
      "oid": "WR-WRPC-MIB::wrpcPtpSkew.0",
      "opcua_name": "PtpSkew",
      "opcua_type": "Int32",
      "description": "Estimated change of master-to-slave delay (ps)",
      "poll_every": 10
    },
    {
      "oid": "WR-WRPC-MIB::wrpcPtpRTT.0",
      "opcua_name": "PtpRoundTripTime",
      "opcua_type": "Int64",
      "description": "The round-trip-time from master (ps)",
      "poll_every": 10
    },
    {
      "oid": "WR-WRPC-MIB::wrpcTemperatureValue.1",
      "opcua_name": "Temperature",
      "opcua_type": "Float",
      "description": "Temperature of the TiCkS PCB (degrees C)",
      "poll_every": 10
    },
    {
      "oid": "WR-WRPC-MIB::wrpcTimeTAI.0",
      "opcua_name": "TimeTAI",
      "opcua_type": "Int64",
      "description": "Current TAI time (seconds since epoch)",
      "poll_every": 10
    },
    {
      "oid": "WR-WRPC-MIB::wrpcTimeSystemUptime.0",
      "opcua_name": "UpTime",
      "opcua_type": "Double",
      "description": "System uptime (ms)",
      "poll_every": 10
    },
    {
      "oid": [
        "WR-WRPC-MIB::wrpcPtpServoStateErrCnt.0",
        "WR-WRPC-MIB::wrpcPtpClockOffsetErrCnt.0",
        "WR-WRPC-MIB::wrpcPtpRTTErrCnt.0"
      ],
      "opcua_name": "PtpErrorCounts",
      "opcua_type": "UInt32",
      "description": "Number of errors: [ servo state errors, clock offset errors, RTT errors ]",
      "poll_every": 60
    },
    {
      "oid": [
        "WR-WRPC-MIB::wrpcPtpTx.0",
        "WR-WRPC-MIB::wrpcPtpRx.0"
      ],
      "opcua_name": "PtpTxAndRx",
      "opcua_type": "UInt64",
      "description": "Number of transmitted and received PTP frames: [ Tx, Rx ]",
      "poll_every": 60
    },
    {
      "oid": [
        "WR-WRPC-MIB::wrpcPortInternalTx.0",
        "WR-WRPC-MIB::wrpcPortInternalRx.0"
      ],
      "opcua_name": "PortTxAndRx",
      "opcua_type": "UInt64",
      "description": "Total transmitted and received frames on WR port (all traffic): [ Tx, Rx ]",
      "poll_every": 60
    },
    {
      "oid": "WR-WRPC-MIB::wrpcPtpAsymmetry.0",
      "opcua_name": "PtpAsymmetry",
      "opcua_type": "Int64",
      "description": "Measured link asymmetry (ps)",
      "poll_every": 60
    },
    {
      "oid": "AUX-DIAG::wrpcAuxDiagDstIpAddr.1",
      "opcua_name": "DstIpAddr",
      "opcua_type": "String",
      "description": "Destination IP address of UCTS timestamps",
      "poll_every": 300
    },
    {
      "oid": "AUX-DIAG::wrpcAuxDiagDstMacAddrH.1",
      "opcua_name": "_DstMacAddr_32MSB",
      "opcua_type": "ByteString",
      "description": "(internal) 32 MSB of destination MAC address",
      "poll_every": 300
    },
    {
      "oid": "AUX-DIAG::wrpcAuxDiagDstMacAddrL.1",
      "opcua_name": "_DstMacAddr_16LSB",
      "opcua_type": "ByteString",
      "description": "(internal) 16 LSB of destination MAC address",
      "poll_every": 300
    },
    {
      "oid": "AUX-DIAG::wrpcAuxDiagDstPort.1",
      "opcua_name": "DstPort",
      "opcua_type": "UInt16",
      "description": "Destination port of UCTS timestamps",
      "poll_every": 300
    },
    {
      "oid": "AUX-DIAG::wrpcAuxDiagThrottle.1",
      "opcua_name": "Throttle",
      "opcua_type": "Int64",
      "description": "Throttle parameter of UCTS TiCkS",
      "poll_every": 300
    },
    {
      "oid": "WR-WRPC-MIB::wrpcVersionSwVersion.0",
      "opcua_name": "WrpcSwVersion",
      "opcua_type": "String",
      "description": "Version of the wrpc software",
      "poll_every": 300
    }
  ],
  "constants": [
    {
      "opcua_name": "SoftwareVersion",
      "opcua_type": "String",
      "description": "Version of the UCTS controller",
      "value": "2.0.1"
    },
    {
      "opcua_name": "tai_offset",
      "opcua_type": "Int32",
      "description": "TAI minus UTC offset in seconds as configured in this server (set via --tai-offset or SetTaiOffset). This reflects the server's working assumption and is not an authoritative statement of the current IERS value.",
      "value": 37
    },
    {
      "opcua_name": "device_command_port",
      "opcua_type": "UInt16",
      "description": "Port number for UDP device commands",
      "value": 55010
    },
    {
      "opcua_name": "Status",
      "opcua_type": "Int64",
      "description": "Status of TiCkS board (raw uint32 status word)",
      "value": null
    },
    {
      "opcua_name": "DstMacAddr",
      "opcua_type": "String",
      "description": "Destination MAC address (aa:bb:cc:dd:ee:ff)",
      "value": null
    },
    {
      "opcua_name": "State",
      "opcua_type": "Int32",
      "description": "TiCkS state: 1=Running, 0=Online/Standby (from Status bit 7)",
      "value": null
    },
    {
      "opcua_name": "FirmwareVersion",
      "opcua_type": "String",
      "description": "TiCkS firmware version (from Status bits 23:16)",
      "value": null
    }
  ],
  "snmp_timeout": 2.0,
  "snmp_retries": 1
}
